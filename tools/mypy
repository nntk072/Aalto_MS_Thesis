#!/usr/bin/env bash
set -euo pipefail
# Run mypy type checker.
# Usage:
#   ./tools/mypy            # check configured root packages (default)
#   ./tools/mypy market_data/  # check specific path

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR"

if [ $# -gt 0 ]; then
  exec uv run mypy "$@"
else
  exec uv run mypy
fi
