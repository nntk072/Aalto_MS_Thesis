#!/usr/bin/env bash
set -euo pipefail
# Run all local checks: ruff, mypy, pytest.
# Mirrors the CI build phase for local verification.
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR"

uv sync --extra dev

echo "==> ruff check"
uv run ruff check .

echo "==> ruff format --check"
uv run ruff format --check .

echo "==> mypy"
uv run mypy quant_rl

echo "==> pytest"
uv run pytest tests/ -v