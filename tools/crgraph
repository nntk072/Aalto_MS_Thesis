#!/usr/bin/env bash
set -euo pipefail
# Code Review Graph wrapper — build, update, and inspect the project's
# persistent incremental knowledge graph.
#
# Usage:
#   ./tools/crgraph            # incremental update (default)
#   ./tools/crgraph build      # full rebuild
#   ./tools/crgraph status     # graph stats
#   ./tools/crgraph changes    # detect-changes against HEAD~1
#   ./tools/crgraph flows      # list execution flows
#   ./tools/crgraph wiki       # generate markdown wiki
#   ./tools/crgraph watch      # watch for changes and auto-update
#   ./tools/crgraph quality    # repository-owned graph/config quality report
#   ./tools/crgraph verify-critical  # invariant checks for source/config/critical symbols

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR"

CRGRAPH_BIN=""
if [[ -n "${CODE_REVIEW_GRAPH_BIN:-}" && -x "${CODE_REVIEW_GRAPH_BIN}" ]]; then
  CRGRAPH_BIN="${CODE_REVIEW_GRAPH_BIN}"
fi
if [[ -z "$CRGRAPH_BIN" && -n "${THESIS_PYTHON:-}" ]]; then
  candidate="$(dirname "$THESIS_PYTHON")/code-review-graph"
  if [[ -x "$candidate" ]]; then
    CRGRAPH_BIN="$candidate"
  fi
fi
if [[ -z "$CRGRAPH_BIN" ]] && command -v code-review-graph >/dev/null 2>&1; then
  CRGRAPH_BIN="$(command -v code-review-graph)"
fi
if [[ -z "$CRGRAPH_BIN" && -x "$SCRIPT_DIR/.venv/bin/code-review-graph" ]]; then
  CRGRAPH_BIN="$SCRIPT_DIR/.venv/bin/code-review-graph"
fi

if [[ -z "$CRGRAPH_BIN" ]]; then
  echo "ERROR: code-review-graph is not installed." >&2
  echo "  uv sync --extra dev" >&2
  exit 1
fi

cmd="${1:-update}"
shift || true

case "$cmd" in
  quality)
    exec python3 scripts/dev/code_graph/graph_quality.py report --label final "$@"
    ;;
  verify-critical)
    exec python3 scripts/dev/code_graph/graph_quality.py check "$@"
    ;;
  build|update|postprocess|embed|watch|status|forget|visualize|wiki|register|unregister|repos|eval|detect-changes|enrich|dead-code|query|impact|search|flows|flow|communities|community|architecture|large-functions|refactor|serve|mcp|daemon)
    exec "$CRGRAPH_BIN" "$cmd" "$@"
    ;;
  -h|--help|help)
    exec "$CRGRAPH_BIN" --help
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run ./tools/crgraph --help for available commands." >&2
    exit 1
    ;;
esac
