#!/usr/bin/env bash
set -euo pipefail
# Remove build artifacts, caches, and virtual environments.
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR"

rm -rf .venv
rm -rf .mypy_cache
rm -rf .ruff_cache
rm -rf .pytest_cache
rm -rf dist
rm -rf build
rm -rf *.egg-info
find . -type d -name __pycache__ -not -path './.venv/*' -not -path './.cache/*' -exec rm -rf {} + 2>/dev/null || true
find . -type f -name '*.pyc' -not -path './.venv/*' -not -path './.cache/*' -delete 2>/dev/null || true

echo "Cleaned build artifacts and caches."