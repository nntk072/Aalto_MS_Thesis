#!/usr/bin/env bash
set -euo pipefail
# Validate JSON files in the repository.
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR"

found=0
while IFS= read -r -d '' f; do
  echo "==> Validating $f"
  python -m json.tool "$f" > /dev/null
  found=1
done < <(find . -name '*.json' -not -path './.venv/*' -not -path './.cache/*' -not -path './node_modules/*' -print0)

if [ "$found" -eq 0 ]; then
  echo "No JSON files found to validate."
fi